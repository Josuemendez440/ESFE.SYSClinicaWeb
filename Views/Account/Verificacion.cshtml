@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curavita - Código de Verificación</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>

    <div class="view-section">
        <div class="login-card">
            <div class="logo-container">
                <img src="~/images/logo.png" alt="Curavita" class="login-logo">
            </div>

            <h2 class="card-title">CÓDIGO DE VERIFICACIÓN</h2>

            <p class="info-msg">Hemos enviado un código de 6 dígitos a tu correo electrónico.</p>

            <!-- Contenedor dinámico de error -->
            <div id="alertBox" class="alert-banner" role="alert"></div>

            <form id="formOtp" onsubmit="return false;" style="width: 100%;">
                <div class="otp-container">
                    <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" autofocus required />
                    <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                    <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                    <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                    <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                    <input type="text" class="otp-input" maxlength="1" pattern="[0-9]" inputmode="numeric" required />
                </div>

                <input type="hidden" id="codigoCompleto" name="CodigoOtp" />

                <button type="button" id="btnVerificar" class="btn-verify">VERIFICAR CÓDIGO</button>
            </form>

            <div class="options-bar">
                <span class="resend-text">¿No recibiste el código? <a href="@Url.Action("Recuperar", "Account")" id="lnkReenviar">Reenviar</a></span>
                <a href="@Url.Action("Recuperar", "Account")">&larr; Volver</a>
            </div>
        </div>
    </div>

    <script src="~/js/verificacion.js"></script>
</body>
</html>