@{
    Layout = null;
    ViewData["Title"] = "Módulo de Facturación - Curavita";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/facturacion.css?v=1.0" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div>
                <div class="brand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                    <span>Curavita</span>
                </div>
                <nav class="nav-menu">
                    <a href="@Url.Action("Inicio", "Account")" class="nav-item @(currentAction.Equals("Inicio", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Inicio">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        <span>Inicio</span>
                    </a>
                    <a href="@Url.Action("Citas", "Account")" class="nav-item @(currentAction.Equals("Citas", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Citas">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span class="citas-label">Mis Citas</span>
                    </a>
                    <a href="@Url.Action("Agendar", "Account")" class="nav-item @(currentAction.Equals("Agendar", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Agendar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Agendar Cita</span>
                    </a>
                    <a href="@Url.Action("Expedientes", "Account")" class="nav-item @(currentAction.Equals("Expedientes", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Expedientes">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        <span>Gestión de Expedientes</span>
                    </a>
                    <a href="@Url.Action("Consulta", "Account")" class="nav-item @(currentAction.Equals("Consulta", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Consulta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                        <span>Consulta Médica</span>
                    </a>
                    <a href="@Url.Action("Facturacion", "Account")" class="nav-item active" data-module="Facturacion">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                        <span>Módulo de Facturación</span>
                    </a>
                </nav>
            </div>
            <div class="sidebar-footer">
                <button type="button" id="btnOpenLogout" class="btn-logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Cerrar Sesión</span>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="facturacion-container">

                <!-- Panel Facturas Pendientes -->
                <section class="card">
                    <div class="card-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <h2>FACTURAS PENDIENTES</h2>
                    </div>

                    <div class="section-subtitle">SELECCIONA UN PACIENTE A FACTURAR</div>

                    <div id="listaFacturasPendientes" class="facturas-list">
                        <!-- Carga dinámica -->
                    </div>
                </section>

                <!-- Panel Detalle de Facturación -->
                <section class="card">
                    <div class="card-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        <h2>DETALLE DE FACTURACIÓN</h2>
                    </div>

                    <div id="panelDetalleVacio" class="empty-state">
                        <p>Selecciona un paciente del panel izquierdo para generar su factura.</p>
                    </div>

                    <form id="formPago" class="hidden">
                        <div class="factura-meta-box">
                            <div>N° FACTURA: <strong id="lblNumeroFactura">FAC-00031</strong></div>
                            <div>FECHA: <strong id="lblFechaFactura">15/09/2026</strong></div>
                        </div>

                        <div class="factura-patient-pill">
                            <div>Paciente: <strong id="lblPacienteFactura">---</strong> (<span id="lblCodigoFactura">---</span>)</div>
                            <div>Servicio: <strong id="lblEspecialidadFactura">---</strong></div>
                        </div>

                        <div class="form-group">
                            <label>DESGLOSE DEL PAGO</label>
                            <div id="desgloseAnticipo" class="desglose-box" style="display:none;"></div>
                        </div>

                        <div class="form-group">
                            <label>TOTAL A PAGAR HOY</label>
                            <div id="montoPagar" class="total-amount">$0.00</div>
                        </div>

                        <div class="form-group">
                            <label for="metodoPago">MÉTODO DE PAGO</label>
                            <select id="metodoPago" class="form-control" required>
                                <option value="Efectivo" selected>Efectivo</option>
                                <option value="Tarjeta">Tarjeta de Débito / Crédito</option>
                            </select>
                        </div>

                        <div class="form-group" id="grupoEfectivo">
                            <label for="montoRecibido">MONTO RECIBIDO ($)</label>
                            <input type="number" id="montoRecibido" class="form-control" step="0.01" min="0" placeholder="0.00" />
                        </div>

                        <div class="form-group" id="grupoCambio">
                            <label>CAMBIO ($)</label>
                            <div id="montoCambio" class="change-amount">$0.00</div>
                        </div>

                        <button type="submit" class="btn-submit" id="btnProcesarPago" disabled>Finalizar</button>
                    </form>
                </section>

            </div>
        </main>
    </div>

    <!-- Modal Flotante Factura Finalizada con Éxito -->
    <div id="modalFacturaFinalizada" class="modal-overlay hidden">
        <div class="modal-success-card">
            <div class="modal-icon-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h3 class="modal-title" style="margin-bottom: 6px;">¡Factura Finalizada con Éxito!</h3>
            <p style="color: #64748b; font-size: 13px; margin-bottom: 16px;">
                La transacción ha sido registrada y liquidada satisfactoriamente.
            </p>

            <div class="modal-summary-box">
                <div class="modal-summary-row">
                    <span>N° Factura:</span>
                    <strong id="modalFacturaNum">FAC-00031</strong>
                </div>
                <div class="modal-summary-row">
                    <span>Paciente:</span>
                    <strong id="modalFacturaPac">---</strong>
                </div>
                <div class="modal-summary-row">
                    <span>Especialidad:</span>
                    <strong id="modalFacturaEsp">---</strong>
                </div>
                <div class="modal-summary-row">
                    <span>Método de Pago:</span>
                    <strong id="modalFacturaMetodo">Efectivo</strong>
                </div>
                <div class="modal-summary-row highlight">
                    <span>Total Cancelado:</span>
                    <strong id="modalFacturaTotal">$0.00</strong>
                </div>
            </div>

            <!-- Envío de Comprobante por Correo -->
            <div class="email-send-group">
                <input type="email" id="inputCorreoFactura" placeholder="correo@paciente.com" />
                <button type="button" id="btnEnviarCorreoFactura" class="btn-send-email">
                    <span>Enviar</span>
                </button>
            </div>

            <!-- Acciones de Factura -->
            <div class="modal-action-buttons">
                <button type="button" id="btnPrintFactura" class="btn-print-bill">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 15px; height: 15px;"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    <span>Ver / Imprimir PDF</span>
                </button>
                <button type="button" id="btnSiguienteFactura" class="btn-finish-all">
                    <span>Listo / Siguiente</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Contenedor Global de Notificaciones (Toast) -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Modal Confirmar Cerrar Sesión (Misma estructura de Inicio) -->
    <div id="logoutModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </div>
            <h3 class="modal-title">¿Cerrar Sesión?</h3>
            <p class="modal-message">¿Estás seguro de que deseas salir del sistema <strong>Curavita</strong>?</p>
            <div class="modal-actions">
                <button id="btnCancelLogout" class="btn-cancel" type="button">Cancelar</button>
                <a href="@Url.Action("Login", "Account")" class="btn-confirm-logout">Sí, Cerrar Sesión</a>
            </div>
        </div>
    </div>

    <script src="~/js/permisos.js" asp-append-version="true"></script>
    <script src="~/js/inicio.js" asp-append-version="true"></script>
    <script src="~/js/validaciones.js" asp-append-version="true"></script>
    <script src="~/js/facturacion.js" asp-append-version="true"></script>
</body>
</html>