@model ESFE.ClinicaWEB.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Curavita - Crear Cuenta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/cuenta.css" asp-append-version="true" />
</head>
<body>

    <div id="registerView" class="view-section">
        <div class="login-card">
            <div class="logo-container">
                <img src="~/images/logo.png" alt="Curavita" class="login-logo">
            </div>

            <h2 class="card-title">CREAR CUENTA</h2>

            <div asp-validation-summary="ModelOnly" style="color: #d94e4e; font-size: 11px; margin-bottom: 10px; text-align: center; width: 100%;"></div>

            <form id="registerForm" method="post" asp-action="Registrar" asp-controller="Account" style="width: 100%;">

                <div class="form-group">
                    <label for="txtNombreReg">Nombre Completo</label>
                    <input type="text" id="txtNombreReg" asp-for="FullName" class="form-control" placeholder="Ej. Juan Pérez" autocomplete="off" required>
                    <span asp-validation-for="FullName" style="color: #d94e4e; font-size: 10.5px;"></span>
                </div>

                <div class="form-group">
                    <label for="txtCorreoReg">Correo Electrónico</label>
                    <input type="email" id="txtCorreoReg" asp-for="Email" class="form-control" placeholder="usuario@curavita.digital" autocomplete="off" required>
                    <span asp-validation-for="Email" style="color: #d94e4e; font-size: 10.5px;"></span>
                </div>

                <div class="form-group">
                    <label for="txtClaveReg">Contraseña</label>
                    <div class="input-wrapper">
                        <input type="password" id="txtClaveReg" asp-for="Password" class="form-control with-toggle"
                               placeholder="••••••••" pattern="^(?=.*[A-Za-z])(?=.*\d).{6,}$"
                               title="La contraseña debe tener mínimo 6 caracteres e incluir letras y números" required>
                        <div id="toggleRegPass" class="pass-toggle-login" title="Mostrar contraseña">
                            <svg class="eyeOff" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                            <svg class="eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </div>
                    </div>
                    <span asp-validation-for="Password" style="color: #d94e4e; font-size: 10.5px;"></span>
                </div>

                <div class="form-group">
                    <label for="txtConfirmarClaveReg">Confirmar Contraseña</label>
                    <div class="input-wrapper">
                        <input type="password" id="txtConfirmarClaveReg" asp-for="ConfirmPassword" class="form-control with-toggle" placeholder="••••••••" required>
                        <div id="toggleConfirmPass" class="pass-toggle-login" title="Mostrar contraseña">
                            <svg class="eyeOff" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                            <svg class="eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </div>
                    </div>
                    <span asp-validation-for="ConfirmPassword" style="color: #d94e4e; font-size: 10.5px;"></span>
                </div>

                <button type="submit" class="btn-login">REGISTRARSE</button>
            </form>

            <div class="options-bar">
                <a href="@Url.Action("Login", "Account")">← Volver al Inicio de Sesión</a>
            </div>
        </div>
    </div>

    <!-- Modal Modal Centrada -->
    <div id="curavitaModalOverlay" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div id="modalIconContainer" class="modal-icon-wrapper">
                <svg id="svgSuccess" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#1c909b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <svg id="svgError" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#d94e4e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="15" y1="9" x2="9" y2="15"></line>
                    <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
            </div>
            <h3 id="modalTitle" class="modal-title">¡REGISTRO EXITOSO!</h3>
            <p id="modalMessage" class="modal-message">Tu cuenta ha sido creada exitosamente. Haz clic abajo para iniciar sesión.</p>
            <button id="btnModalConfirm" class="btn-login" style="margin-top: 0;">ACEPTAR</button>
        </div>
    </div>

    <script src="~/js/cuenta.js" asp-append-version="true"></script>
</body>
</html>