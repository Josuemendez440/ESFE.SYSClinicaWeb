@{
    Layout = null;
    ViewData["Title"] = "Confirmar Pago de Cita - Curavita";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Enlace al archivo CSS externo -->
    <link rel="stylesheet" href="~/css/pago.css" />
</head>
<body>
    <div class="checkout-container">

        <!-- Columna Izquierda: Resumen de la Cita -->
        <div class="summary-card">
            <div class="summary-header">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                    <path d="M9 16l2 2 4-4"></path>
                </svg>
                <h2>Resumen de tu Cita</h2>
            </div>

            <div class="summary-details">
                <div class="detail-item">
                    <div class="icon-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </div>
                    <div>
                        <span class="detail-label">PACIENTE</span>
                        <p class="detail-value" id="resumenPaciente">Cargando...</p>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="icon-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                    </div>
                    <div>
                        <span class="detail-label">ESPECIALIDAD Y MÉDICO</span>
                        <p class="detail-value" id="resumenMedico">Cargando...</p>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="icon-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <div>
                        <span class="detail-label">FECHA Y HORA</span>
                        <p class="detail-value" id="resumenFechaHora">Cargando...</p>
                    </div>
                </div>
            </div>

            <div class="pricing-box">
                <div class="price-row">
                    <span>Precio total de la consulta:</span>
                    <span class="price-amount" id="precioTotalDisplay">$25.00</span>
                </div>
                <div class="price-row">
                    <span>Saldo pendiente en clínica (75%):</span>
                    <span class="price-amount" id="saldoPendienteDisplay">$18.75</span>
                </div>
                <hr class="price-divider" />
                <div class="price-row total-row">
                    <span>Anticipo a pagar hoy (25%):</span>
                    <span class="total-amount" id="anticipoDisplay">$6.25</span>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Formulario de Pago y Tarjeta -->
        <div class="payment-card">
            <div class="payment-badge">
                <div class="badge-left">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <span>Pago Seguro con Cifrado SSL</span>
                </div>
                <div class="card-brands">
                    <span class="brand-tag visa">VISA</span>
                    <span class="brand-tag mc">MC</span>
                    <span class="brand-tag amex">AMEX</span>
                </div>
            </div>

            <!-- Tarjeta Visual -->
            <div class="credit-card-preview">
                <div class="card-chip"></div>
                <div class="card-number-display" id="cardNumDisplay">•••• •••• •••• ••••</div>
                <div class="card-footer-display">
                    <div>
                        <span class="card-label">TITULAR</span>
                        <div class="card-holder-display" id="cardNameDisplay">NOMBRE COMPLETO</div>
                    </div>
                    <div>
                        <span class="card-label">EXPIRA</span>
                        <div class="card-exp-display" id="cardExpDisplay">MM/AA</div>
                    </div>
                </div>
            </div>

            <!-- Formulario de Tarjeta -->
            <form id="paymentForm" asp-controller="Account" asp-action="ConfirmarPago" method="post" class="payment-form">
                @Html.AntiForgeryToken()

                <div id="alertError" class="alert-error"></div>

                <div class="form-group">
                    <label for="cardName">Nombre del Titular</label>
                    <div class="input-icon-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <input type="text" id="cardName" name="TitularTarjeta" placeholder="Como aparece en la tarjeta" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="cardNumber">Número de Tarjeta</label>
                    <div class="input-icon-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                        <input type="text" id="cardNumber" name="NumeroTarjeta" placeholder="0000 0000 0000 0000" maxlength="19" inputmode="numeric" required />
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="cardExp">Expiración</label>
                        <div class="input-icon-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                            <input type="text" id="cardExp" name="Expiracion" placeholder="MM/AA" maxlength="5" inputmode="numeric" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="cardCvv">Código CVV</label>
                        <div class="input-icon-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                            <input type="text" id="cardCvv" name="Cvv" placeholder="123" maxlength="4" pattern="\d{3,4}" inputmode="numeric" required />
                        </div>
                    </div>
                </div>

                <button type="submit" id="btnPay" class="btn-pay">
                    <svg id="btnPayIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    <span id="btnPayText">Pagar $12.50 y Confirmar Cita</span>
                </button>

                <p class="pay-disclaimer">
                    Al hacer clic en pagar, autorizas el cobro del 25% ($12.50) para la reserva de tu cita. El 75% restante ($37.50) se abonará en la recepción el día de tu consulta.
                </p>
            </form>
        </div>

    </div>

    <!-- Modal Flotante de Éxito Corporativo -->
    <div id="modalPagoExitoso" class="modal-overlay hidden">
        <div class="modal-card">
            <div class="modal-icon-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h3 class="modal-title">¡Pago Confirmado con Éxito!</h3>
            <p class="modal-desc">
                El anticipo del 25% (<strong id="modalAnticipo">$6.25</strong>) ha sido procesado de manera segura y tu cita médica está oficialmente reservada en el sistema.
            </p>

            <div class="modal-summary-box">
                <div class="modal-summary-row">
                    <span>Paciente:</span>
                    <strong id="modalPaciente">-</strong>
                </div>
                <div class="modal-summary-row">
                    <span>Especialidad y Médico:</span>
                    <strong id="modalMedico">-</strong>
                </div>
                <div class="modal-summary-row">
                    <span>Fecha y Hora:</span>
                    <strong id="modalFechaHora">-</strong>
                </div>
                <div class="modal-summary-row highlight">
                    <span>Saldo pendiente en clínica (75%):</span>
                    <strong class="saldo-text" id="modalSaldo">$18.75</strong>
                </div>
            </div>

            <p class="modal-subtext">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                <span>Hemos enviado el comprobante oficial a tu correo electrónico registrado.</span>
            </p>

            <button type="button" id="btnVerCitas" class="btn-modal-action">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>Ver mis citas</span>
            </button>
        </div>
    </div>
    <script src="~/js/pago.js"></script>
</body>
</html>