@{
    Layout = null;
    ViewData["Title"] = "Inicio - Curavita";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Curavita - Inicio</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/inicio.css?v=1.0" />
</head>
<body>

    <div class="app-container">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                <span>Curavita</span>
            </div>
            <ul class="sidebar-menu">
                <li class="menu-item @(currentAction.Equals("Inicio", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Inicio">
                    <a href="@Url.Action("Inicio", "Account")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        Inicio
                    </a>
                </li>
                <li class="menu-item @(currentAction.Equals("Citas", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Citas" id="menuItemCitas">
                    <a href="@Url.Action("Citas", "Account")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span class="citas-label">Mis Citas</span>
                    </a>
                </li>
                <li class="menu-item @(currentAction.Equals("Agendar", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Agendar">
                    <a href="@Url.Action("Agendar", "Account")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Agendar Cita
                    </a>
                </li>
                <li class="menu-item @(currentAction.Equals("Expedientes", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Expedientes">
                    <a href="@Url.Action("Expedientes", "Account")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        Gestión de Expedientes
                    </a>
                </li>
                <li class="menu-item @(currentAction.Equals("Consulta", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Consulta">
                    <a href="@Url.Action("Consulta", "Account")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2h-.2ZM17 21a2 2 0 0 0 4-4v-3h-4v7ZM3 10h4V3H3v7ZM12 21a5 5 0 0 0 5-5v-3H7v3a5 5 0 0 0 5 5Z" /></svg>
                        Consulta Médica
                    </a>
                </li>
                <li class="menu-item @(currentAction.Equals("Facturacion", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Facturacion">
                    <a href="@Url.Action("Facturacion", "Account")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                        Módulo de Facturación
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <button id="btnOpenLogout" class="btn-logout" type="button">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    Cerrar Sesión
                </button>
            </div>
        </aside>

        <main class="main-content">
            <header class="top-header">
                <h1>Inicio</h1>
                <div class="user-dropdown">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <span id="headerUserName">Usuario</span>
                </div>
            </header>

            <div class="dashboard-body">
                <div class="welcome-card">
                    <div class="profile-avatar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    </div>

                    <h2 class="welcome-title">¡Hola, Usuario!</h2>
                    <p class="welcome-subtitle">Bienvenido de nuevo a tu portal médico Curavita.</p>

                    <a href="@Url.Action("Agendar", "Account")" class="btn-agendar" data-module="Agendar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Agendar Cita
                    </a>
                </div>

                <div class="modules-grid">
                    <a href="@Url.Action("Citas", "Account")" class="module-card" data-module="Citas">
                        <div class="module-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        </div>
                        <h3 class="module-title">Mis Citas</h3>
                        <p class="module-desc">Revisa tus citas programadas y el estado de cada una.</p>
                    </a>

                    <a href="@Url.Action("Agendar", "Account")" class="module-card" data-module="Agendar">
                        <div class="module-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        </div>
                        <h3 class="module-title">Agendar Cita</h3>
                        <p class="module-desc">Programa una nueva cita médica con tu especialista de confianza.</p>
                    </a>

                    <a href="@Url.Action("Expedientes", "Account")" class="module-card" data-module="Expedientes">
                        <div class="module-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        </div>
                        <h3 class="module-title">Gestión de Expedientes</h3>
                        <p class="module-desc">Administra historiales clínicos, resultados y documentos de pacientes.</p>
                    </a>

                    <a href="@Url.Action("Consulta", "Account")" class="module-card" data-module="Consulta">
                        <div class="module-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2h-.2ZM17 21a2 2 0 0 0 4-4v-3h-4v7ZM3 10h4V3H3v7ZM12 21a5 5 0 0 0 5-5v-3H7v3a5 5 0 0 0 5 5Z" /></svg>
                        </div>
                        <h3 class="module-title">Consulta Médica</h3>
                        <p class="module-desc">Accede a las consultas programadas y revisa el historial clínico.</p>
                    </a>

                    <a href="@Url.Action("Facturacion", "Account")" class="module-card" data-module="Facturacion">
                        <div class="module-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                        </div>
                        <h3 class="module-title">Módulo de Facturación</h3>
                        <p class="module-desc">Gestiona pagos, facturas y recibos de los pacientes.</p>
                    </a>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal de Confirmación de Cerrar Sesión -->
    <div id="logoutModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </div>
            <h3 class="modal-title">¿Cerrar Sesión?</h3>
            <p class="modal-message">¿Estás seguro de que deseas salir del sistema <strong>Curavita</strong>?</p>
            <div class="modal-actions">
                <button id="btnCancelLogout" class="btn-cancel" type="button">Cancelar</button>
                <a href="@Url.Action("Login", "Account")" class="btn-confirm-logout">Sí, Cerrar Sesión</a>
            </div>
        </div>
    </div>

    <script src="~/js/permisos.js" asp-append-version="true"></script>
    <script src="~/js/inicio.js" asp-append-version="true"></script>
</body>
</html>