@{
    Layout = null;
    ViewData["Title"] = "Gestión de Expedientes - Curavita";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/expedientes.css?v=1.0" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div>
                <div class="brand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                    <span>Curavita</span>
                </div>
                <nav class="nav-menu">
                    <a href="@Url.Action("Inicio", "Account")" class="nav-item @(currentAction.Equals("Inicio", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Inicio">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                        <span>Inicio</span>
                    </a>
                    <a href="@Url.Action("Citas", "Account")" class="nav-item @(currentAction.Equals("Citas", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Citas">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span class="citas-label">Mis Citas</span>
                    </a>
                    <a href="@Url.Action("Agendar", "Account")" class="nav-item @(currentAction.Equals("Agendar", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Agendar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Agendar Cita</span>
                    </a>
                    <a href="@Url.Action("Expedientes", "Account")" class="nav-item active" data-module="Expedientes">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        <span>Gestión de Expedientes</span>
                    </a>
                    <a href="@Url.Action("Consulta", "Account")" class="nav-item @(currentAction.Equals("Consulta", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Consulta">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                        <span>Consulta Médica</span>
                    </a>
                    <a href="@Url.Action("Facturacion", "Account")" class="nav-item @(currentAction.Equals("Facturacion", StringComparison.OrdinalIgnoreCase) ? "active" : "")" data-module="Facturacion">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                        <span>Módulo de Facturación</span>
                    </a>
                </nav>
            </div>
            <div class="sidebar-footer">
                <button type="button" id="btnOpenLogout" class="btn-logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    <span>Cerrar Sesión</span>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="expedientes-container">

                <!-- Sección Crear Expediente -->
                <section class="card">
                    <div class="card-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <h2>CREAR EXPEDIENTE</h2>
                    </div>

                    <form id="formCrearExpediente" method="post" asp-action="Crear">
                        <div class="form-group">
                            <label for="nombres">NOMBRES</label>
                            <input type="text" id="nombres" name="Nombres" placeholder="Ej. Juan Carlos" required />
                        </div>

                        <div class="form-group">
                            <label for="apellidos">APELLIDOS</label>
                            <input type="text" id="apellidos" name="Apellidos" placeholder="Ej. Mendoza López" required />
                        </div>

                        <div class="form-group">
                            <label for="dui">DOCUMENTO DE IDENTIDAD (DUI)</label>
                            <input type="text" id="dui" name="Dui" placeholder="00000000-0" required />
                        </div>

                        <div class="form-group">
                            <label for="telefono">TELÉFONO DE CONTACTO</label>
                            <input type="tel" id="telefono" name="Telefono" placeholder="0000-0000" required />
                        </div>

                        <div class="form-group">
                            <label for="fechaNacimiento">FECHA DE NACIMIENTO</label>
                            <input type="date" id="fechaNacimiento" name="FechaNacimiento" required />
                        </div>

                        <button type="submit" class="btn-submit">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                            <span>Guardar Nuevo Expediente</span>
                        </button>
                    </form>
                </section>

                <!-- Sección Buscar Paciente -->
                <section class="card">
                    <div class="card-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <h2>BÚSQUEDA DE PACIENTES EXISTENTES</h2>
                    </div>

                    <div class="form-group">
                        <label for="inputBusqueda">BUSCAR POR NOMBRE O DOCUMENTO DE IDENTIDAD</label>
                        <input type="text" id="inputBusqueda" placeholder="Escriba un nombre o DUI..." />
                    </div>

                    <div class="table-container">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>CÓDIGO</th>
                                    <th>NOMBRE DEL PACIENTE</th>
                                    <th>DOCUMENTO (DUI)</th>
                                    <th>ESTADO</th>
                                    <th class="text-right">ACCIÓN</th>
                                </tr>
                            </thead>
                            <tbody id="tablaPacientes">
                                <!-- Contenido dinámico vía JavaScript -->
                            </tbody>
                        </table>
                    </div>
                </section>

            </div>
        </main>
    </div>

    <!-- Modal Operación Exitosa -->
    <div id="modalOperacionExitosa" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-icon icon-success">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h3 class="modal-title">¡Operación Exitosa!</h3>
            <p class="modal-message" id="msgOperacionExitosa">Expediente guardado correctamente.</p>
            <div class="modal-actions">
                <button type="button" class="btn-primary-action" id="btnAceptarOperacion">Aceptar</button>
            </div>
        </div>
    </div>

    <!-- Modal Asignar Especialidad y Cita -->
    <div id="modalAsignarCita" class="modal-overlay hidden">
        <div class="modal-box modal-wide">
            <div class="modal-icon icon-specialty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
            </div>
            <h3 class="modal-title">Asignar Especialidad y Cita</h3>
            <p class="modal-message">
                Paciente: <strong id="modalAsignarPaciente">---</strong> (<span id="modalAsignarCodigo">---</span>)
            </p>

            <div class="modal-form-content">
                <div class="form-group text-left">
                    <label for="selectEspecialidad">ESPECIALIDAD MÉDICA</label>
                    <select id="selectEspecialidad" class="modal-select">
                        <option value="Medicina General" data-costo="25.00" selected>Medicina General ($25.00)</option>
                        <option value="Pediatría" data-costo="35.00">Pediatría ($35.00)</option>
                        <option value="Cardiología" data-costo="50.00">Cardiología ($50.00)</option>
                    </select>
                </div>

                <div class="form-group text-left">
                    <label for="selectMedico">MÉDICO ASIGNADO</label>
                    <select id="selectMedico" class="modal-select">
                        <option value="Dr. Roberto Gómez" data-id="3">Dr. Roberto Gómez (Medicina General)</option>
                        <option value="Dra. Elena Ramos" data-id="4">Dra. Elena Ramos (Medicina General)</option>
                        <option value="Dr. Roberto Fuentes" data-id="5">Dr. Roberto Fuentes (Medicina General)</option>
                    </select>
                </div>

                <div class="form-group text-left">
                    <label>MONTO CONSULTA</label>
                    <div id="displayMontoConsulta" class="display-costo">$25.00</div>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" id="btnCancelarAsignacion">Cancelar</button>
                <button type="button" class="btn-primary-action" id="btnConfirmarAsignacion">Confirmar Cita</button>
            </div>
        </div>
    </div>

    <!-- Modal Detalle de Cita Asignada -->
    <div id="modalDetalleCita" class="modal-overlay hidden">
        <div class="modal-box modal-wide">
            <div class="modal-icon" style="background-color: #fef3c7; color: #d97706;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
            </div>
            <h3 class="modal-title">Cita Médica Asignada</h3>
            <p class="modal-message">
                Paciente: <strong id="detalleCitaPaciente">---</strong> (<span id="detalleCitaCodigo">---</span>)
            </p>

            <div class="modal-form-content" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin: 16px 0; text-align: left; font-size: 14px; line-height: 2;">
                <div><strong>Especialidad:</strong> <span id="detalleCitaEspecialidad">Medicina General</span></div>
                <div><strong>Médico Asignado:</strong> <span id="detalleCitaMedico">Dr. Roberto Gómez</span></div>
                <div><strong>Fecha y Hora:</strong> <span id="detalleCitaFechaHora">---</span></div>
                <div><strong>Costo Consulta:</strong> <span id="detalleCitaCosto">$25.00</span></div>
                <div><strong>Estado Actual:</strong> <span class="badge-status badge-espera">En Espera (Cola de Consulta)</span></div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn-cancel" id="btnCerrarDetalleCita" style="width: 100%;">Cerrar</button>
            </div>
        </div>
    </div>

    <!-- Contenedor Global de Notificaciones (Toast) -->
    <div id="toastContainer" class="toast-container"></div>

    <!-- Modal Confirmar Cerrar Sesión (Misma estructura de Inicio) -->
    <div id="logoutModal" class="modal-overlay hidden">
        <div class="modal-box">
            <div class="modal-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
            </div>
            <h3 class="modal-title">¿Cerrar Sesión?</h3>
            <p class="modal-message">¿Estás seguro de que deseas salir del sistema <strong>Curavita</strong>?</p>
            <div class="modal-actions">
                <button id="btnCancelLogout" class="btn-cancel" type="button">Cancelar</button>
                <a href="@Url.Action("Login", "Account")" class="btn-confirm-logout">Sí, Cerrar Sesión</a>
            </div>
        </div>
    </div>

    <script src="~/js/permisos.js" asp-append-version="true"></script>
    <script src="~/js/inicio.js" asp-append-version="true"></script>
    <script src="~/js/validaciones.js" asp-append-version="true"></script>
    <script src="~/js/expedientes.js" asp-append-version="true"></script>
</body>
</html>